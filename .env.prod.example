# =====================================================
# mixx-expresso — Variables d'environnement PRODUCTION
# Copier en .env.prod et renseigner les valeurs réelles
# NE JAMAIS committer ce fichier avec de vraies valeurs
# =====================================================

APP_VERSION=latest
DOMAIN=your-domain.com

# --- Base de données ---
R2DBC_HOST=mssql
R2DBC_DB_NAME=mixxExpresso
R2DBC_USERNAME=app_user
R2DBC_PASSWORD=CHANGE_ME_STRONG_PASSWORD
SA_PASSWORD=CHANGE_ME_SA_PASSWORD

# --- Expresso ERS ---
EXPRESSO_URL_ERS=http://10.71.47.17:8913/topupservice/service
EXPRESSO_WSDL_URL=http://10.71.47.17:8913/topupservice/service?wsdl
EXPRESSO_INITIATOR_PRINCIPAL_ID=CHANGE_ME
EXPRESSO_INITIATOR_PASSWORD=CHANGE_ME
EXPRESSO_CLIENT_ID=Transfert2Com
EXPRESSO_TIMEOUT_MS=15000

# --- Mobiquity ---
URL_MOBIQUITY_BASE=https://mobiquity-host/
URL_CANCEL_TX=https://mobiquity-host/services/mfs/cancelTx
MOBIQUITY_TIMEOUT=30
MOBIQUITY_STATUS_CHECK_TIMEOUT=10

# --- Redis ---
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# --- Elasticsearch ---
ELASTIC_HOST=elasticsearch
ELASTIC_PORT=9200
ELASTIC_USERNAME=elastic
ELASTIC_PASSWORD=CHANGE_ME_ELASTIC_PASSWORD
ES_CLUSTER_NAME=mixx-expresso-prod

# --- Kibana ---
KIBANA_ENCRYPTION_KEY=CHANGE_ME_32_CHARS_MIN
KIBANA_REPORTING_KEY=CHANGE_ME_32_CHARS_MIN

# --- JWT ---
JHIPSTER_SECURITY_AUTHENTICATION_JWT_BASE64_SECRET=CHANGE_ME_openssl_rand_-base64_64

# --- MPIN ---
MPIN_ENCRYPTION_SECRET=CHANGE_ME_openssl_rand_-base64_32

# --- SMS ---
SMS_API_URL=https://sms-gateway/
SMS_SERVER_IP=
SMS_SENDER=MIXX-EXPRESSO
SMS_TIMEOUT=10
RETRY_ATTEMPTS=3

# --- Mail ---
MAIL_HOST=smtp.yourmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_FROM=noreply@mixx.sn
MAIL_FROM_DISPLAY_NAME=MIXX BY YAS
APP_BASE_URL=https://your-domain.com

# --- Grafana ---
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
GRAFANA_SECRET_KEY=CHANGE_ME_32_CHARS_MIN

# --- Logs ---
LOG_PATH=/app/logs
LOG_FILE_NAME=mixx-expresso.log

# --- Dashboard cache ---
DASHBOARD_CACHE_REFRESH_MS=300000