# =====================================================
# mixx-expresso — Variables d'environnement (dev)
# Copier ce fichier en .env et renseigner les valeurs
#
# Ports décalés pour coexister avec mixx-pay-impot :
#   MSSQL   1434, Redis 6380, ES 9201, app 8081
# =====================================================

# --- Application ---
SERVER_PORT=8081

# --- Base de données R2DBC (MSSQL) ---
# Port hôte 1434 (docker-compose mappe 1434→1433 dans le container)
R2DBC_HOST=localhost
R2DBC_PORT=1434
R2DBC_DB_NAME=mixxExpresso
R2DBC_USERNAME=SA
R2DBC_PASSWORD=yourStrong(!)Password
SA_PASSWORD=yourStrong(!)Password

# --- Expresso ERS (SOAP) ---
EXPRESSO_URL_ERS=http://10.71.47.17:8913/topupservice/service
EXPRESSO_WSDL_URL=http://10.71.47.17:8913/topupservice/service?wsdl
EXPRESSO_INITIATOR_PRINCIPAL_ID=
EXPRESSO_INITIATOR_PASSWORD=
EXPRESSO_CLIENT_ID=Transfert2Com
EXPRESSO_TIMEOUT_MS=15000

# --- Mobiquity ---
URL_MOBIQUITY_BASE=https://mobiquity-host/
URL_CANCEL_TX=https://mobiquity-host/services/mfs/cancelTx
MOBIQUITY_TIMEOUT=30
MOBIQUITY_STATUS_CHECK_TIMEOUT=10

# --- Redis ---
# Port hôte 6380 (docker-compose mappe 6380→6379 dans le container)
REDIS_HOST=localhost
REDIS_PORT=6380

# --- Elasticsearch ---
# Port hôte 9201 (docker-compose mappe 9201→9200 dans le container)
ELASTIC_HOST=localhost
ELASTIC_PORT=9201
ELASTIC_USERNAME=
ELASTIC_PASSWORD=
SPRING_ELASTICSEARCH_URIS=http://localhost:9201

# --- Tracing (Jaeger) ---
# Port hôte 4319 (docker-compose mappe 4319→4318 dans le container)
OTLP_TRACING_ENDPOINT=http://localhost:4319/v1/traces

# --- SMS Gateway ---
SMS_API_URL=https://192.168.41.45:9040
SMS_SERVER_IP=192.168.41.45
SMS_SENDER=MIXX-EXPRESSO
SMS_TIMEOUT=10
RETRY_ATTEMPTS=3

# --- Mail (MailHog dev) ---
# Port hôte 1026 (docker-compose mappe 1026→1025 dans le container)
MAIL_HOST=localhost
MAIL_PORT=1026
MAIL_FROM=noreply@mixx.sn
MAIL_FROM_DISPLAY_NAME=MIXX BY YAS

# --- JWT ---
# Générer : openssl rand -base64 64
JHIPSTER_SECURITY_AUTHENTICATION_JWT_BASE64_SECRET=

# --- MPIN Encryption (AES-256-GCM) ---
# Générer : openssl rand -base64 32
MPIN_ENCRYPTION_SECRET=

# --- Logs ---
LOG_PATH=./logs
LOG_FILE_NAME=mixx-expresso.log

# --- Dashboard cache ---
DASHBOARD_CACHE_REFRESH_MS=300000

# --- Grafana ---
GRAFANA_ADMIN_PASSWORD=admin